# ID del Google Sheet (la parte tra /d/ e /edit nell'URL)
GOOGLE_SHEET_ID=
# Credenziali del service account (campi del file JSON scaricato)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Incollare la private_key mantenendo i \n letterali, tra virgolette
GOOGLE_PRIVATE_KEY=

# Codice di accesso richiesto nella landing (obbligatorio in produzione)
ACCESS_CODE=

# Opzionali (valori di default mostrati)
SHEET_NAME=Presenze
COL_PRESENZA=L
COL_ID=M
COL_IP=N
COL_TIMESTAMP=O

# Solo sviluppo locale: usa dati fittizi in memoria, senza Google
# MOCK_SHEET=1
